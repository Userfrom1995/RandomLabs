-- A do block sequences effects; the statements are separated by semicolons.
-- With no scripted input, readLine reads the empty string, so this prints 0.
-- Feeding it input lines with `printf 'a\nb\n' | halcyon run effects.hly`
-- prints the line count instead.
let rec loop = fn n => do {
  line <- readLine;
  if line == "" then do { printLine n }
  else do { loop (n + 1) }
}
in loop 0