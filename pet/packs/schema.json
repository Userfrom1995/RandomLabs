{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://randomlabs/pages/pet/packs/schema.json",
  "title": "Desktop Pet creator pack",
  "description": "Data-only third-party character pack. JSON only, never code. pack.json follows #/definitions/manifest and each characters/*.json file follows #/definitions/character.",
  "type": "object",
  "definitions": {
    "manifest": {
      "type": "object",
      "required": ["slug", "name", "version"],
      "additionalProperties": true,
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 32},
        "name": {"type": "string", "minLength": 1, "maxLength": 48},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "author": {"type": "string", "maxLength": 64},
        "description": {"type": "string", "maxLength": 500},
        "engine_min": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "engine_max": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "characters": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "body_plan", "palette", "traits", "dialogue"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 24},
        "species": {"type": "string", "maxLength": 48},
        "body_plan": {"enum": ["blob", "quadruped", "slime", "avian", "robot", "winged"]},
        "tagline": {"type": "string", "maxLength": 200},
        "signature": {"type": "string", "maxLength": 280},
        "palette": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z_]+$"},
          "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
        },
        "traits": {
          "type": "object", "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "hunger_rate": {"type": "number", "minimum": 0, "maximum": 0.4},
            "energy_drain": {"type": "number", "minimum": 0, "maximum": 0.3},
            "energy_restore": {"type": "number", "minimum": 0, "maximum": 0.8},
            "affection_decay": {"type": "number", "minimum": 0, "maximum": 0.25},
            "walk_speed": {"type": "number", "minimum": 8, "maximum": 120},
            "play_bonus": {"type": "number", "minimum": -0.2, "maximum": 0.2},
            "sleep_bonus": {"type": "number", "minimum": -0.2, "maximum": 0.2},
            "react_bonus": {"type": "number", "minimum": -0.2, "maximum": 0.2}
          }
        },
        "dialogue": {
          "type": "object", "minProperties": 1,
          "propertyNames": {
            "pattern": "^(mood:(happy|curious|sleepy|grumpy|hungry|affectionate)|event:(poke|feed|play|wake|sleep|greet|stroke|catch))$"
          },
          "additionalProperties": {
            "type": "array", "minItems": 3,
            "items": {"type": "string", "minLength": 1, "maxLength": 280}
          }
        },
        "replies": {
          "type": "object", "minProperties": 1,
          "propertyNames": {
            "pattern": "^(greeting|name|mood|hunger|sleep|energy|affection|joke|comfort|feed|wake|play|time|help)$"
          },
          "additionalProperties": {
            "type": "array", "minItems": 3,
            "items": {"type": "string", "minLength": 1, "maxLength": 280}
          }
        },
        "sprite": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z_]+$"}
        }
      }
    }
  }
}
