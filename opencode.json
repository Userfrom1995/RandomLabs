{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "compaction": {
    "auto": true,
    "buffer": 100000,
    "keep": {
      "tokens": 15000
    }
  },
  "providers": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": {
            "context": 1000000
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": { "*": "allow" },
    "doom_loop": "allow"
  }
}
