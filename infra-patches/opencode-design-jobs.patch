From 3cb0aaa70faf6cf435795046fe5ae2715a5d68aa Mon Sep 17 00:00:00 2001
From: The Builder <github-actions[bot]@users.noreply.github.com>
Date: Sat, 3 Oct 2026 21:59:48 +0000
Subject: [PATCH] builder: wire 4 Design Council jobs in opencode.yml with
 collision and general exclusion guards (Refs #528)

---
 .github/workflows/opencode.yml | 690 +++++++++++++++++++++++++++++++++
 1 file changed, 690 insertions(+)

diff --git a/.github/workflows/opencode.yml b/.github/workflows/opencode.yml
index 6b70cccb..d2319cd7 100644
--- a/.github/workflows/opencode.yml
+++ b/.github/workflows/opencode.yml
@@ -1141,6 +1141,688 @@ jobs:
           APPROVE_PR="$pr" APPROVE_NOTIFY_ISSUE="$pr" APPROVE_SERVER="${{ github.server_url }}" APPROVE_BOT_TOKEN="${{ github.token }}" \
             bash .github/scripts/approve-held-runs.sh
 
+  design:
+    if: |
+      (startsWith(github.event.comment.body, '/oc design') ||
+       startsWith(github.event.comment.body, '/opencode design')) &&
+      !startsWith(github.event.comment.body, '/oc design-ux') &&
+      !startsWith(github.event.comment.body, '/oc design-visual') &&
+      !startsWith(github.event.comment.body, '/oc design-motion') &&
+      !startsWith(github.event.comment.body, '/opencode design-ux') &&
+      !startsWith(github.event.comment.body, '/opencode design-visual') &&
+      !startsWith(github.event.comment.body, '/opencode design-motion')
+    concurrency:
+      group: opencode-design-${{ github.event.issue.number }}
+      cancel-in-progress: false
+    runs-on: macos-latest
+    timeout-minutes: 75
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v6
+        with:
+          persist-credentials: true
+          token: ${{ github.token }}
+          ref: ${{ github.event.repository.default_branch || github.ref_name }}
+          fetch-depth: 0
+
+      - name: Actor write gate (issue #428)
+        id: actor_gate
+        shell: bash
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GATE_EVENT: ${{ github.event_name }}
+          GATE_ACTOR: ${{ github.actor }}
+          GATE_LABEL: design
+        run: bash .github/scripts/actor-write-gate.sh
+
+      - name: Configure git identity
+        run: |
+          git config --global user.name "The Design Council"
+          git config --global user.email "github-actions[bot]@users.noreply.github.com"
+
+      - name: Clear runtime decision
+        run: rm -f /tmp/random-lab-decision.json
+
+      - name: Run opencode design council agent
+        id: opencode
+        if: steps.actor_gate.outputs.run == 'true'
+        continue-on-error: true
+        timeout-minutes: 60
+        uses: ./.github/actions/opencode-run
+        env:
+          OPENCODE_API_KEY: ${{ secrets.OPENCODE_API_KEY }}
+          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
+          GITHUB_TOKEN: ${{ github.token }}
+        with:
+          model: opencode/muse-spark-1.3-contributor-free
+          use_github_token: true
+          prompt: |
+            You are the Design Council of the Random lab, triggered by "/oc design".
+
+            READ FIRST: `.github/agents/design-council.md` - that file IS your complete system prompt; every rule there is binding (four-round deliberation via subagent swarms, artifact contract, unanimity-minus-one convergence with recorded dissent). If the file is missing from the tree, rely on the safety net below plus AGENTS.md.
+
+            SAFETY NET (always binding):
+            - Before ending the run, you MUST write `/tmp/random-lab-decision.json` with exactly one action: `{"action":"build"}` (design complete, Builder proceeds), `{"action":"continue"}` (needs another council round), or `{"action":"maintainer"}` (blocked).
+            - Sign your work: every commit subject starts with `design:`, every comment ends with ` - the Design Council`.
+            - You never post "/oc" comments yourself.
+            - Commit as `github-actions[bot]`, push, and leave the working tree clean.
+
+      - name: Verify design decided, else auto-retry
+        id: verify-phase
+        if: always()
+        env:
+          GH_TOKEN: ${{ secrets.OPENCODE_PAT }}
+          AGENT_GATE: ${{ steps.actor_gate.outputs.run }}
+        run: |
+          if [ "${AGENT_GATE:-}" != "true" ]; then
+            echo "::notice::Actor write gate skipped the design agent (issue #428): denial is not a crash - no auto-retry, no escalation."
+            echo "outcome=skipped" >> "$GITHUB_OUTPUT"
+            echo "handled=true" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          outcome="${{ steps.opencode.outcome }}"
+          if [ -f /tmp/random-lab-decision.json ]; then
+            echo "Decision file present; design phase produced a handoff."
+            exit 0
+          fi
+          issue="${{ github.event.issue.number }}"
+          if [ -n "${{ github.event.issue.pull_request.html_url }}" ]; then
+            pr="$issue"
+          else
+            pr=$(gh pr list --repo "${{ github.repository }}" --state open --json number,headRefName,createdAt \
+              --jq '[.[] | select(.headRefName | startswith("opencode/issue'"${issue}"'-"))] | sort_by(.createdAt) | last | .number' 2>/dev/null)
+          fi
+          target="${pr:-$issue}"
+          if [ "$outcome" != "success" ]; then
+            echo "::error::Design step finished with outcome '$outcome' and no decision file (crashed mid-run)."
+            retries=$(gh api "repos/${{ github.repository }}/issues/$target/comments" \
+              --jq '[.[] | select(.user.login == "${{ github.repository_owner }}" and (.body | startswith("/oc design (auto-retry")))] | length' 2>/dev/null || true)
+            if [ -z "$retries" ] || ! [ "$retries" -eq "$retries" ] 2>/dev/null; then
+              echo "::error::Could not enumerate prior auto-retries on #$target (API/rate-limit failure). Refusing to auto-retry to avoid a runaway loop."
+              echo "handled=true" >> "$GITHUB_OUTPUT"
+              exit 1
+            fi
+            if [ "$retries" -lt 3 ]; then
+              n=$((retries + 1))
+              echo "Posting auto-retry $n"
+              echo "handled=true" >> "$GITHUB_OUTPUT"
+              gh api "repos/${{ github.repository }}/issues/$target/comments" -f body="/oc design (auto-retry $n)"
+              exit 0
+            fi
+            echo "Design council dead after 4 attempts (1 initial + 3 auto-retries); notifying Maintainer."
+            echo "handled=true" >> "$GITHUB_OUTPUT"
+            gh issue comment "$target" --repo "${{ github.repository }}" --body "/oc maintainer" || true
+            exit 1
+          fi
+          echo "::error::Design step reported success but wrote no decision file (silent no-op); failing loudly instead of exiting green."
+          exit 1
+
+      - name: Forward design decision
+        if: always() && steps.actor_gate.outputs.run == 'true' && steps.verify-phase.outputs.handled != 'true'
+        env:
+          GH_TOKEN: ${{ secrets.OPENCODE_PAT }}
+        run: |
+          issue="${{ github.event.issue.number }}"
+          pr=$(gh pr list --repo "${{ github.repository }}" --state open --json number,headRefName \
+            --jq '[.[] | select(.headRefName | startswith("opencode/issue'"${issue}"'-"))] | sort_by(.createdAt) | last | .number' 2>/dev/null || echo "")
+          target="${pr:-$issue}"
+          if [ ! -f /tmp/random-lab-decision.json ]; then
+            echo "No decision file found. Notifying Maintainer (/oc maintainer)"
+            gh issue comment "$target" --repo "${{ github.repository }}" --body "/oc maintainer" || true
+            exit 0
+          fi
+          action=$(jq -r '.action' /tmp/random-lab-decision.json 2>/dev/null || echo "")
+          if [ "$action" = "build" ]; then
+            echo "Design complete! Handing over to Builder (/oc build this)"
+            gh issue comment "$target" --repo "${{ github.repository }}" --body "/oc build this" || true
+          elif [ "$action" = "continue" ]; then
+            echo "Design needs another round (/oc design)"
+            gh issue comment "$target" --repo "${{ github.repository }}" --body "/oc design" || true
+          else
+            echo "Unknown action: $action. Notifying Maintainer (/oc maintainer)"
+            gh issue comment "$target" --repo "${{ github.repository }}" --body "/oc maintainer" || true
+          fi
+
+      - name: Clean working tree (prevent auto-commit leaks)
+        if: always()
+        run: |
+          git checkout -- . >/dev/null 2>&1 || true
+          git clean -fd >/dev/null 2>&1 || true
+          dirty=$(git status --porcelain)
+          if [ -n "$dirty" ]; then echo "dirty after clean:"; echo "$dirty"; fi
+          exit 0
+
+      - name: Strip owner Co-authored-by trailers from the PR branch
+        if: always() && steps.actor_gate.outputs.run == 'true'
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          bash .github/scripts/strip-trailers.sh
+
+      - name: Approve held CI runs on the PR
+        continue-on-error: true
+        if: always() && steps.actor_gate.outputs.run == 'true'
+        env:
+          GH_TOKEN: ${{ secrets.OPENCODE_PAT }}
+        run: |
+          set +e
+          issue="${{ github.event.issue.number }}"
+          if [ -n "${{ github.event.issue.pull_request.html_url }}" ]; then
+            pr="$issue"
+          else
+            pr=$(gh pr list --repo "${{ github.repository }}" --state open --json number,headRefName,createdAt \
+              --jq '[.[] | select(.headRefName | startswith("opencode/issue'"${issue}"'-"))] | sort_by(.createdAt) | last | .number' 2>/dev/null)
+          fi
+          APPROVE_PR="$pr" APPROVE_NOTIFY_ISSUE="$pr" APPROVE_SERVER="${{ github.server_url }}" APPROVE_BOT_TOKEN="${{ github.token }}" \
+            bash .github/scripts/approve-held-runs.sh
