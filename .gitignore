# Python bytecode
__pycache__/
*.py[cod]
*.so

# Test/build artifacts
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
*.o

# prism build artifacts - never commit
prism/build-debug/
prism/build/
prism/build-*/
prism/cmake-build-*/

# Generated audio
*.wav
# Thunderline Pages player ships deterministic preview renders (committed;
# generated by thunderline/tools/export_preview.py from dist/, provenance in
# player/audio/preview.json). Full-rate dist/ above stays local build output.
!thunderline/player/audio/*.wav
!thunderline/player/audio/stems/*.wav

# Editors & OS
.vscode/
.idea/
*.swp
.DS_Store
.maintainer/
gambit/gambit

# Glyphforge build output
glyphforge/build/

# Kestrel runtime artifacts (downloaded MNIST, trained model outputs)
kestrel/data/
kestrel/model.json

# Lab agent runtime state (never commit agent decision files)
.agent/
tmp_random_lab_*
/tmp/random-lab-*

# Specstory
.specstory/

# Tabula SwiftPM build output (regenerated by swift test)
tabula/.build/

# Sextant dotnet outputs (regenerated by dotnet build/test/publish)
sextant/**/bin/
sextant/**/obj/
sextant/publish/

# Node dependencies (never commit - regenerated by npm ci)
node_modules/

# PostFormer CPU-training checkpoints (issue #294: artifacts, never committed;
# ledger curves/CSVs under postformer/ledger stay tracked by design)
postformer/ledger/checkpoints/
