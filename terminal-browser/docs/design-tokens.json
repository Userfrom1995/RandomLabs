{
  "case": {
    "nav": "Title Case, max 12 chars",
    "state": "UPPERCASE 2-3 chars only (GO, OK, ERR, ACT)",
    "tags": "verbatim lowercase",
    "urls": "verbatim lowercase"
  },
  "chrome": {
    "asciiOnly": true,
    "contentRows": "3-22 borderless",
    "rects": "static chrome only (lines 1-2, 23-24), + - | characters",
    "rowMap": {
      "addressBar": 1,
      "content": "2 to H-2 overlay zone",
      "statusLine": "H-1",
      "tabStrip": 0
    }
  },
  "collapse": {
    "16color": {
      "accent": "bright-cyan foreground, never background",
      "activeBG": "blue background plus white bold",
      "err": "red foreground, ERR: prefix",
      "ok": "green foreground, ok: prefix",
      "warm": "yellow foreground, ! prefix"
    },
    "ascii": {
      "accent": "plain plus brackets",
      "activeBG": "> markers plus reverse where available",
      "err": "ERR: prefix",
      "focus": "marker plus reverse, never color alone",
      "ok": "ok: prefix"
    },
    "truecolor256": {
      "accentFill": "dark #1E222E key cell on #78C8FF",
      "focusRow": "white on #34466E full width"
    }
  },
  "colors": {
    "accent": "#78C8FF",
    "accentOnChromeBG": "8.69:1",
    "activeBG": "#34466E",
    "body": "#E8EAF2 on #1E222E 13.21:1",
    "chromeBG": "#1E222E",
    "chromeFG": "#E8EAF2",
    "err": "#FF8A9B",
    "errOnChromeBG": "7.07:1",
    "focusRow": "#FFFFFF on #34466E 9.34:1",
    "muted": "#9AA0B5",
    "mutedOnStatusBG": "6.68:1",
    "mutedRule": "never on activeBG",
    "ok": "#7DE08B",
    "okOnChromeBG": "9.75:1",
    "statusBG": "#161A24",
    "statusFGOnStatusBG": "14.48:1",
    "warm": "#FFD178",
    "warmOnChromeBG": "11.06:1"
  },
  "hintChips": {
    "budgetGt120": 14,
    "budget81to120": 10,
    "budgetLe80": 6,
    "format": "eN plus 1 pad",
    "keypressForm": "[K] verb, [^F] verb, [q] verb",
    "maxCellsPerSnapshot": 56,
    "overflow": "+NN more reverse-video underlined button, opens drawer",
    "render": "once per settled gen, never per frame",
    "row": "single row, priority focused links buttons inputs, DOM order stable"
  },
  "motion": {
    "governorFps": "10-30",
    "interruption": "any key cancels in 1 tick, paints final state",
    "reducedMotion": {
      "env": "REDUCED_MOTION=1",
      "flag": "--reduced-motion",
      "policy": "all durations 0ms, zero-frame cuts, static anchor overlap, loading text at 1Hz max"
    },
    "strobeWindowMs": 150,
    "ticks": {
      "T1Ms": 33,
      "T2Ms": 50,
      "T3Ms": 100
    }
  },
  "noDimSimulation": true,
  "snapshots": {
    "emitWhen": "load event plus 300ms quiet plus no pending AX updates",
    "envelope": "{gen, stable, refs: [{eN, role, name}]}",
    "staleRecovery": "ref_stale with reason plus R remap, never silent",
    "unstable": "chips dimmed, act blocked with wait settled hint"
  },
  "spacing": {
    "chromeLines": 5,
    "contentLinesAt80x24": 19
  },
  "viewport": {
    "displacement": "one anchored cut 1xT2 with 1 anchor row plus gutter marker",
    "replace": "zero-frame cut",
    "rowScroll": "never animated"
  },
  "drawer": {
    "border": "1-cell box plus scrim one level",
    "behavior": "pure overlay, zero reflow, exact viewport restore",
    "rows": 3
  },
  "hub": {
    "bg": "#0C0E14",
    "panel": "#161A24",
    "ink": "#E8EAF2",
    "accent": "#78C8FF",
    "warm": "#FFD178"
  }
}
